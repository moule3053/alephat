# Copy to deploy/.env and adjust. Compose passes each secret only to services that need it.
#   cp deploy/.env.example deploy/.env

# ---------------------------------------------------------------------------
# Compose project
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=alephat

# Host ports (map container ports to these on localhost)
API_HOST_PORT=8080
UI_HOST_PORT=3005
WEBHOOK_HOST_PORT=8081
POSTGRES_HOST_PORT=5432
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233
LITELLM_HOST_PORT=4000

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=alephat
POSTGRES_PASSWORD=alephat
POSTGRES_DB=alephat
# Used by app containers (hostname = compose service name)
DATABASE_URL=postgresql+asyncpg://alephat:alephat@postgres:5432/alephat

# ---------------------------------------------------------------------------
# Self-hosted Temporal Service & Worker routing
# ---------------------------------------------------------------------------
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=alephat-agents

# ---------------------------------------------------------------------------
# LLM — direct providers (default) and optional LiteLLM
# ---------------------------------------------------------------------------
# LLM_MODE=auto|direct|litellm
#   auto   — use LiteLLM only if LITELLM_ENABLED=true; else direct if keys set
#   direct — always call OpenAI/Anthropic/Fireworks/Google APIs
#   litellm — always use LiteLLM proxy
LLM_MODE=auto
LITELLM_ENABLED=false
LITELLM_BASE_URL=
LITELLM_API_KEY=sk-litellm
LITELLM_MASTER_KEY=sk-litellm

# Direct provider keys (used when LLM_MODE=direct or auto without LiteLLM)
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
GOOGLE_API_KEY=

# Model ids: openai:gpt-4o-mini | anthropic:claude-sonnet-4-20250514 | mock:local | …
DEFAULT_MODEL=openai:gpt-4o-mini

# ---------------------------------------------------------------------------
# Platform defaults
# ---------------------------------------------------------------------------
# Selectable sandbox provider: local | agent_sandbox | substrate | daytona | opensandbox
DEFAULT_SANDBOX_PROVIDER=local
DEFAULT_ORG_ID=00000000-0000-4000-8000-000000000001
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000002
API_AUTH_DISABLED=true
# GitHub OAuth requires at least one allowed user or organization.
ALLOWED_GITHUB_USERS=
ALLOWED_GITHUB_ORGS=
PLATFORM_API_TOKEN=
PLATFORM_JWT_SECRET=
CORS_ORIGINS=http://localhost:3005

# Run timeouts & retries
MAX_RUN_DURATION_SECONDS=14400
MAX_RUN_RETRIES=3

# Fernet key for secrets at rest & Temporal Event History payload encryption
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Sandbox providers. Stub mode is explicit and intended only for local UI testing.
# ---------------------------------------------------------------------------
ALLOW_STUB_SANDBOXES=true
LOCAL_SANDBOX_ROOT_DIR=/workspace
DAYTONA_API_KEY=
DAYTONA_SANDBOX_SNAPSHOT=daytonaio/sandbox:0.6.0
OPENSANDBOX_BASE_URL=
OPENSANDBOX_API_KEY=
AGENT_SANDBOX_NAMESPACE=agent-sandboxes
# Agent Substrate (https://github.com/agent-substrate/substrate) settings
# Select by setting DEFAULT_SANDBOX_PROVIDER=substrate.
# In Kubernetes: point SUBSTRATE_API_ENDPOINT=api.ate-system.svc:443 and
#   SUBSTRATE_ROUTER_URL=https://atenet-router.ate-system.svc:443.
# In Docker Compose: either point at a Substrate cluster / `kubectl ate proxy`
#   or start `--profile with-substrate` with SUBSTRATE_ROUTER_URL=http://substrate-sandbox:8888.
SUBSTRATE_API_ENDPOINT=
SUBSTRATE_API_TLS=true
SUBSTRATE_API_SERVER_NAME=api.ate-system.svc
SUBSTRATE_API_CA_CERT_PATH=
SUBSTRATE_API_TOKEN=
SUBSTRATE_API_TOKEN_PATH=
SUBSTRATE_API_CREDENTIAL_BUNDLE_PATH=
SUBSTRATE_ROUTER_URL=
SUBSTRATE_ROUTER_SERVER_NAME=atenet-router.ate-system.svc
SUBSTRATE_ROUTER_CA_CERT_PATH=
SUBSTRATE_ROUTER_CLIENT_CERT_PATH=
SUBSTRATE_ROUTER_CLIENT_KEY_PATH=
SUBSTRATE_ROUTER_CREDENTIAL_BUNDLE_PATH=
SUBSTRATE_ATESPACE=alephat-sandboxes
SUBSTRATE_ACTOR_TEMPLATE=alephat-sandbox
# toolbox (alephat-sandbox /execute,/upload,/download) | process (Substrate demos/sandbox /process)
SUBSTRATE_SANDBOX_PROTOCOL=toolbox
SUBSTRATE_EGRESS_ALLOWED_HOSTS=github.com,api.github.com,objects.githubusercontent.com,pypi.org,files.pythonhosted.org,registry.npmjs.org
SUBSTRATE_SUSPEND_ON_STOP=true
MCP_STDIO_ALLOWED=false
MCP_ALLOW_PRIVATE_NETWORKS=false
MCP_TOOL_TIMEOUT_SECONDS=120
MAX_MCP_SERVERS_PER_RUN=10

# ---------------------------------------------------------------------------
# Webhook secrets (optional in local; empty = signature checks skipped)
# ---------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET="your-slack-signing-secret"
SLACK_BOT_TOKEN="xoxb-your-bot-token"
SLACK_APP_TOKEN="xapp-your-app-level-token"
SLACK_APP_ID="A0123456789"
SLACK_BOT_USER_ID="U0123456789"
SLACK_BOT_USERNAME="alephat"
# Rich messages: host renderer (`make platform-slack-renderer`) or Compose service.
SLACK_RENDERER_URL="http://127.0.0.1:8082"
SLACK_RENDERER_TOKEN=""
# Explicit provider identity -> platform users.user_id mapping for authorized buttons.
# Example: {"T0123456789:U0123456789":"00000000-0000-4000-8000-000000000002"}
SLACK_USER_MAP='{}'
WEBHOOK_SIGNATURES_REQUIRED=false

# ---------------------------------------------------------------------------
# Worker identity (overridden per replica with hostname in compose)
# ---------------------------------------------------------------------------
WORKER_ID=harness-1
