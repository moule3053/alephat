# Alephat — webhook ingress (GitHub / Slack)
# Build: docker build -f deploy/Dockerfile.webhook -t alephat-webhook .
FROM python:3.14-slim-bookworm AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock README.md ./
COPY openswe ./openswe
COPY packages ./packages
COPY vendor ./vendor
COPY alephat_platform ./alephat_platform
COPY migrations ./migrations

RUN pip install --no-cache-dir uv \
    && uv sync --locked --no-dev

FROM python:3.14-slim-bookworm AS runtime

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser

COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    SERVICE_NAME=webhook

USER appuser
EXPOSE 8081

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8081/healthz || exit 1

CMD ["uvicorn", "alephat_platform.webhook.app:app", "--host", "0.0.0.0", "--port", "8081"]
